// Windows resources: the application icon and version information.
// GLFW (inside raylib) looks for an icon named GLFW_ICON and also uses it for the game window.
// The icon itself is generated by tools/make_icon.cpp (`mingw32-make icon`).
GLFW_ICON ICON "tetris.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0x0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Tetris"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "tetris"
            VALUE "OriginalFilename", "tetris.exe"
            VALUE "ProductName",      "Tetris"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
